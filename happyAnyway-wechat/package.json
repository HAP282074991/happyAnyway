{
  "name": "happyanyway-wechat",
  "version": "0.1.0",
  "private": true,
  "description": "Independent native WeChat mini program",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint miniprogram",
    "check:structure": "node scripts/check-structure.mjs",
    "test:architecture": "node --test tests/*.test.mjs",
    "verify": "npm run test:architecture && npm run lint && npm run typecheck && npm run build && npm run check:structure"
  },
  "devDependencies": {
    "eslint": "9.39.4",
    "miniprogram-api-typings": "5.2.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
